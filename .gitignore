__pycache__/
*.py[cod]
*.egg-info/
/build/
dist/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Pre-merge backups: recreated by the merge tools, not source of truth.
*.pre_coco_merge
*.pre_capreg_merge

# Raw CAPRI exports. These are large gdxdump listings (ALL_DATA2.txt alone is
# ~129 MB) and are inputs to tools/build/ingest_capreg_data2.py, not repository
# content. Keep them outside the tree or attach them to a release.
capri_export/
DATA2_*.txt
*.gdx
.cache/

# CAPRI's own files converted for the parity tests (large; rebuilt by tools/build/build_*_reference.py from the
# uploads); only their README is versioned
capri_reference/*/
# the data pipeline's store (raw downloads, Delta tables, manifest): relocatable, rebuilt from the manifest
capri_data/pipeline/store/

# Run logs and check reports the tools write each time they run (not data; removed from the tree 27 October 2026)
capri_data/validation/capmod_market_extraction.json
capri_data/validation/data2_extraction_summary.json
capri_data/validation/remaining_nine_extraction.json
capri_data/validation/trade_recalibration_2017.json
capri_data/validation/world_price_arbitrage_check.csv
capri_data/validation/world_price_divergence.csv
