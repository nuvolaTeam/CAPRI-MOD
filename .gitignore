__pycache__/
*.py[cod]
*.egg-info/
/build/
dist/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Pre-merge backups: recreated by the merge tools, not source of truth.
*.pre_coco_merge
*.pre_capreg_merge

# Raw CAPRI exports. These are large gdxdump listings (ALL_DATA2.txt alone is
# ~129 MB) and are inputs to tools/build/ingest_capreg_data2.py, not repository
# content. Keep them outside the tree or attach them to a release.
capri_export/
DATA2_*.txt
*.gdx
.cache/

# CAPRI's own files converted for the parity tests (large; rebuilt by tools/build/build_*_reference.py from the
# uploads); only their README is versioned
capri_reference/*/
# the data pipeline's store (raw downloads, Delta tables, manifest): relocatable, rebuilt from the manifest
capri_data/pipeline/store/
