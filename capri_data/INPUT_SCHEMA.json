{
 "_doc": "Declarative input schema for CAPRI-Python. This is the single source of truth for what data the model needs, where it comes from, and which module consumes it. The rebuild reads THIS file and regenerates every input from the declared source, writing per-cell provenance. Adding a module = adding entries here, not changing code. Swapping GDX for an external source later = changing the 'source' block of an entry, not touching the loader.",
 "_provenance_schema": {
  "source_type": "CAPRI_GDX | CAPRI_SOURCE | DERIVED | LITERATURE | EXTERNAL | FALLBACK",
  "source_ref": "the concrete origin, e.g. 'capreg DATA2 YILD' now, 'Eurostat apro_cpsh1' after a future swap",
  "vintage": "year or CAPRI release the values represent",
  "confidence": "validated | derived | placeholder",
  "reproducibility": "public_code | access_controlled | internal_derivation | manual",
  "_note": "reproducibility distinguishes a public Eurostat code (anyone can re-pull) from FADN (access-controlled, needs query+date+version) from a CAPRI GDX read. Carried now so a future external swap is a field edit, not a redesign."
 },
 "_module_ownership": "each input names the module(s) that consume it, so the dependency graph is explicit and a new module's needs are declared rather than discovered",
 "modules": {
  "supply": "regional PMP supply, 248 NUTS-2 x 40 activities",
  "market": "Armington market, EU27 bloc x 32 commodities",
  "policy": "CAP instruments",
  "environment": "nutrient/manure/GHG indicators",
  "feed": "feed requirements and availability",
  "biofuel": "biofuel demand",
  "_extension_pattern": "CAPRI's own optional modules (water, ghg, farmtype) attach by declaring inputs and reading core outputs. A new downstream-indicator module declares only outputs it reads; a new-behaviour module declares new inputs and any feedback into the supply/market solve via 'feeds_into'."
 },
